# ────────────────────────────────────────────────────────────────
# Production Environment Variables
# ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your production values

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://emoratest:YOUR_PASSWORD@postgres:5432/emoratest
POSTGRES_DB=emoratest
POSTGRES_USER=emoratest
POSTGRES_PASSWORD=your_secure_password_here

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["https://emoratest.com","https://www.emoratest.com"]

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://emoratest.com
FRONTEND_URL=https://emoratest.com

# ── Email (Required for password reset & email verification) ────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
SMTP_FROM_EMAIL=noreply@emoratest.com
SMTP_FROM_NAME=EmoraTest
