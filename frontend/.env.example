# EmoraTest Frontend Environment Variables
# Copy this file to .env.local and update values for your environment

# Base URL for canonical tags, sitemap, and SEO metadata
# Local: http://localhost:3000
# Production: https://emoratest.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Backend API URL (proxied via Next.js rewrites in development)
NEXT_PUBLIC_API_URL=http://localhost:8000
